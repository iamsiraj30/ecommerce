{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,

    "moduleResolution": "bundler",

    "ignoreDeprecations": "6.0",
    "typeRoots": ["./node_modules/@types", "./src/types"]

  },
  "include": ["src/**/*"],
  "exclude": ["node_modules","dist","generated/prisma"]
}
